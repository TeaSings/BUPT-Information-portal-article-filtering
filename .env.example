# Copy this file to .env and fill in your own mailbox settings.
# Do not commit .env.

# SMTP examples:
# QQ mail: smtp.qq.com, port 465, secure true, use an authorization code.
# 163 mail: smtp.163.com, port 465, secure true, use an authorization code.
# Outlook: smtp.office365.com, port 587, secure false.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Usually MAIL_FROM can be the same as SMTP_USER.
MAIL_FROM=
MAIL_TO=

# DeepSeek OpenAI-compatible API.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
AI_MAX_ARTICLES=80
AI_MAX_CONTENT_CHARS=2600
AI_MAX_IMAGE_OCR_CHARS=1800
AI_TEMPERATURE=0.2
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high

# OCR for article images. Use chi_sim+eng for Chinese and English portal images.
OCR_ENABLED=true
OCR_LANGUAGES=chi_sim+eng
OCR_CACHE_DIR=data/ocr-cache

# Optional. Override the browser executable if needed.
# BROWSER_EXECUTABLE_PATH=/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge

# Optional. Headless portal login for local automation.
BUPT_AUTO_LOGIN=false
BUPT_USERNAME=
BUPT_PASSWORD=
BUPT_LOGIN_TIMEOUT_MS=45000
