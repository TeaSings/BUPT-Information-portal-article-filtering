{
  "portal": {
    "baseUrl": "http://my.bupt.edu.cn/",
    "timezone": "Asia/Shanghai",
    "authStatePath": "state/bupt-auth.json",
    "sections": [
      {
        "name": "news",
        "label": "新闻",
        "startUrls": [
          "http://my.bupt.edu.cn/list.jsp?urltype=tree.TreeTempUrl&wbtreeid=1221"
        ],
        "entryTextHints": ["新闻", "校园新闻", "综合新闻", "要闻"],
        "entryHrefHints": ["news", "xw", "xinwen"]
      },
      {
        "name": "notice",
        "label": "通知",
        "startUrls": [
          "http://my.bupt.edu.cn/list.jsp?urltype=tree.TreeTempUrl&wbtreeid=1305"
        ],
        "entryTextHints": ["通知", "公告", "通知公告", "公示"],
        "entryHrefHints": ["notice", "tz", "gonggao", "announcement"]
      }
    ]
  },
  "crawler": {
    "headless": true,
    "navigationTimeoutMs": 30000,
    "maxArticlePages": 80,
    "collectImages": true,
    "maxImagesPerArticle": 6,
    "minImageDimension": 80,
    "maxImageBytes": 8388608,
    "maxSectionEntryUrls": 4,
    "includeSameHostOnly": true,
    "blockedFileExtensions": [".jpg", ".jpeg", ".png", ".gif", ".webp", ".svg", ".css", ".js", ".zip", ".rar", ".7z", ".mp4", ".mp3"]
  },
  "ai": {
    "enabled": true,
    "baseUrl": "https://api.deepseek.com",
    "model": "deepseek-v4-pro",
    "maxArticles": 80,
    "maxContentChars": 2600,
    "maxImageOcrChars": 1800,
    "temperature": 0.2,
    "thinking": "enabled",
    "reasoningEffort": "high",
    "promptPath": "prompts/daily-ai-summary.md"
  },
  "ocr": {
    "enabled": true,
    "languages": ["chi_sim", "eng"],
    "cacheDir": "data/ocr-cache"
  },
  "email": {
    "subjectPrefix": "北邮信息门户日报",
    "fromName": "BUPT Portal Monitor",
    "to": "",
    "includeSkippedCount": true
  },
  "queue": {
    "dailyDir": "daily",
    "retentionDays": {
      "sent": 30,
      "failed": 14,
      "pending": 45
    }
  }
}
